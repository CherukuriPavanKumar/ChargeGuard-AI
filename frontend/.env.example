# ---------------------------------------------------------------------------
# ChargeGuard.AI frontend configuration
# ---------------------------------------------------------------------------
# Copy to `.env.local` and edit. Vite only exposes variables prefixed VITE_.

# Base URL of the FastAPI backend.
#
# LEAVE EMPTY for a static deploy. That is a supported, documented mode, not a
# degraded one: the simulator probes /health at mount, finds nothing, and falls
# back to computing the gate trace and the expected-value rule in the browser
# from `src/lib/economics.js` -- which mirrors `policy/economics.py`. The panel
# says on screen which mode it is in, so a viewer is never shown client-side
# arithmetic dressed up as a live API response.
#
# The one thing that cannot run in a browser is the gradient-boosted model, so
# each preset carries a recorded probability for its exact input, labelled as
# recorded and stamped with the model version that produced it.
#
# Set this when running the full stack locally:
#   VITE_API_URL=http://localhost:8000
VITE_API_URL=
